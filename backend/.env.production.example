# =============================================================================
# PingCraft - Backend 生产环境配置
# =============================================================================
# 复制为 .env.production；NODE_ENV=production 时加载，docker-compose 也可通过 env_file 引用
# 部署前必须：1) 配置强随机 JWT_SECRET  2) 确保 SEEKDB_* 与部署环境一致
# =============================================================================

# ---------- 应用 ----------
NODE_ENV=production
PORT=3000

# ---------- CORS 与前端地址（同源部署时与对外域名一致） ----------
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------- JWT 鉴权（必须修改为强随机值） ----------
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------- 敏感字段加密密钥（AES-256-GCM，必须设置） ----------
# 用于加密存储 OAuth token、client_secret、LLM api_key 等敏感字段。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 密钥丢失后已加密的历史数据将无法解密，请妥善保管（如同时备份到密钥管理服务）。
ENCRYPTION_KEY=

# ---------- PingCode OAuth（PINGCODE_HOST 必填，部署时改为实际 PingCode 根 URL） ----------
PINGCODE_REDIRECT_URI=http://localhost:3000/auth/callback
PINGCODE_HOST=http://your-pingcode-host:port

# ---------- PingCode 工时单位（estimated_workload 字段） ----------
# LLM 按小时输出 estimated_hours，导入时按此配置转换为 PingCode 所需单位。
# 可选值：minute / hour / day（默认 hour）
PINGCODE_WORKLOAD_UNIT=hour

# ---------- SeekDB（docker-compose 中常覆盖为 SEEKDB_HOST=seekdb） ----------
SEEKDB_HOST=seekdb
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=pingcode_agent
SEEKDB_RETRY_COUNT=5
SEEKDB_RETRY_INTERVAL_MS=2000

# ---------- 同步工作项批处理（可选） ----------
SYNC_WORK_ITEM_BATCH_SIZE=25
SYNC_BATCH_DELAY_MS=500

# ---------- 导入并发与文件清理（可选） ----------
PINGCODE_IMPORT_CONCURRENCY=3
DEMAND_FILE_TTL_HOURS=720

# ---------- 查重与缓存（可选，P3） ----------
DUPLICATE_SIMILARITY_THRESHOLD=0.75
STATS_CACHE_TTL_MS=300000
