# =============================================================================
# PingCraft - Backend 开发环境配置
# =============================================================================
# 复制为 .env.development，当 NODE_ENV=development 时由 config 自动加载
# =============================================================================

# ---------- 应用 ----------
NODE_ENV=development
PORT=3000

# ---------- CORS 与前端地址 ----------
CORS_ORIGIN=http://localhost:5177
FRONTEND_URL=http://localhost:5177

# ---------- JWT 鉴权（开发可用弱密钥，生产务必更换） ----------
JWT_SECRET=dev_secret_key

# ---------- 敏感字段加密密钥（AES-256-GCM）----------
# 用于加密存储 OAuth token、client_secret、LLM api_key 等敏感字段。
# 支持 hex（64 字符）、base64（32 字节）或其他字符串（自动 SHA-256 派生）。
# 生产环境必须设置；留空时开发环境使用固定派生 key（仅本地）。
# ENCRYPTION_KEY=

# ---------- PingCode OAuth（PINGCODE_HOST 必填，示例为占位，请改为实际地址） ----------
PINGCODE_REDIRECT_URI=http://localhost:3000/auth/callback
PINGCODE_HOST=http://your-pingcode-host:port

# ---------- PingCode 工时单位（estimated_workload 字段） ----------
# LLM 按小时输出 estimated_hours，导入时按此配置转换为 PingCode 所需单位。
# 可选值：minute / hour / day（默认 hour）
PINGCODE_WORKLOAD_UNIT=hour

# ---------- SeekDB（OceanBase） ----------
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=root
SEEKDB_DATABASE=pingcode_agent
SEEKDB_RETRY_COUNT=5
SEEKDB_RETRY_INTERVAL_MS=2000

# ---------- 同步工作项批处理（可选） ----------
SYNC_WORK_ITEM_BATCH_SIZE=25
SYNC_BATCH_DELAY_MS=500

# ---------- 导入并发与文件清理（可选） ----------
# 工作项批量导入时的 PingCode API 并发数（默认 3）
PINGCODE_IMPORT_CONCURRENCY=3
# 需求文档文件保留时长（小时，默认 720 即 30 天；仍被导入记录引用的文件不受此限制）
DEMAND_FILE_TTL_HOURS=720

# ---------- 查重与缓存（可选，P3） ----------
# 查重相似度阈值（0-1，默认 0.75；低于此分数不视为重复）
DUPLICATE_SIMILARITY_THRESHOLD=0.75
# 统计数据缓存有效期（毫秒，默认 300000 即 5 分钟）
STATS_CACHE_TTL_MS=300000
