{
  "name": "@pingcraft/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent-first CLI for PingCode + PingCraft",
  "license": "MIT",
  "bin": {
    "pingcode": "./bin/pingcode.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./sdk": "./dist/sdk/index.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "axios": "^1.13.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "axios-mock-adapter": "^2.1.0"
  }
}
