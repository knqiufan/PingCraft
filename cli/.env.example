# PingCraft CLI 环境变量示例
# 复制为 .env 并填值。Phase 0 仅占位，以下变量在 Phase 1 起启用。

# ---- PingCode 官方 OAuth（Phase 1 启用）----
# PingCode 开放平台基础地址
PINGCODE_HOST=https://open.pingcode.com
# OAuth 应用凭证（client_credentials 或 authorization_code 模式）
PINGCODE_CLIENT_ID=
PINGCODE_CLIENT_SECRET=
# 直接提供访问令牌时可跳过 OAuth（优先级低于显式登录态）
PINGCODE_ACCESS_TOKEN=

# ---- PingCraft 本地后端（Phase 3 启用，pingcraft 业务命名空间）----
# 部署 PingCraft 后端服务的地址
PINGCRAFT_API_URL=http://localhost:3000
